DMC_BASE_URL=https://dmc-dev.intergateway.net

# Sale Marketing (requester) role — creates the Requirement/OD/P&L
# (create-od.spec.ts, create-pl.spec.ts) and submits the OD product
# checklist + P&L cost detail (salemarketing.spec.ts).
DMC_EMAIL=pakawat@harmonyx.co
DMC_PASSWORD=

# Solution role — fills in P&L Solution Cost (solution.spec.ts).
SOLUTION_EMAIL=
SOLUTION_PASSWORD=

# VP Sale Marketing role — approves the OD and the P&L (vp-salemarketing.spec.ts).
VP_SALEMARKETING_EMAIL=
VP_SALEMARKETING_PASSWORD=

# VP Solution role — final P&L approval (vp-solution.spec.ts).
VP_SOLUTION_EMAIL=
VP_SOLUTION_PASSWORD=

# "Select Item" relational picker values used when filling the mock data —
# must match real records that exist in this environment.
DMC_CUSTOMER_NAME=pakawat
DMC_SALESPERSON=Thitapa Sales
DMC_REQUESTOR=Thitapa Sales

# Optional: override the mock Requirement's Project Name prefix (default:
# "Mock Project - Network Upgrade Test", matching
# cleanup-mock-requirements.spec.ts's own default CLEANUP_PROJECT_NAME_PATTERN
# so a normal run stays auto-cleanable). A timestamp is always appended for
# uniqueness. Set this per-run for a one-off named Requirement, e.g.:
#   DMC_PROJECT_NAME_PREFIX=automation npx playwright test --project=vp-solution
# DMC_PROJECT_NAME_PREFIX=
